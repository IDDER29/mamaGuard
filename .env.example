# MamaGuard environment variables — copy to .env and fill in real values.
# NEVER commit the filled-in .env (it is git-ignored).

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=                 # webhook handshake token you choose

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only (webhook, cron, server actions). Bypasses RLS.
# Required once RLS is enabled; keep it secret and never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider (OpenAI preferred; MiniMax used as fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o          # optional; defaults to gpt-4o-mini if unset
MINIMAX_API_KEY=
# MINIMAX_MODEL=abab6.5s-chat # optional

# --- Voice (ElevenLabs TTS) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- SMS fallback channel (Plan 2.2; optional — degrades gracefully if unset) ---
# Used when a patient's preferred_channel is "sms" (e.g. no smartphone).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cron auth (Vercel Cron: check-in + appointment reminders + SLA monitor) ---
CRON_SECRET=

# --- Device / interop ingestion tokens (Plan E8.3 / E8.6; optional) ---
INGEST_TOKEN=        # Bearer token for POST /api/ingest/vitals (wearable/cuff)
FHIR_TOKEN=          # Bearer token for POST /api/fhir/observation (EHR write-back)

# --- Fine-tuned Darija model "MamaLlama" (Plan E8.5; optional, OpenAI-compatible) ---
# When set, preferred over OpenAI/MiniMax for the conversational reply only.
MAMALLAMA_BASE_URL=  # host base WITHOUT /v1 (code appends /v1/chat/completions), e.g. https://your-host
MAMALLAMA_API_KEY=
MAMALLAMA_MODEL=mamallama

# --- Scheduled report export (Plan E7.2; optional) ---
REPORT_WEBHOOK_URL=  # weekly patient CSV is POSTed here (storage/email webhook)

# --- Auth gate (optional) ---
# Set to "true" to keep /dashboard open without login (demo mode).
DISABLE_AUTH=true
